From 0c102a75d719e47ad5c30cc3baa477350e0e0885 Mon Sep 17 00:00:00 2001
From: Alexey Lapshin <alexey.lapshin@espressif.com>
Date: Sun, 23 Nov 2025 00:20:39 +0700
Subject: [PATCH 1/3] xtensa: fix segfault from uninitialized
 xtensa_default_isa in the linker

---
 bfd/elf32-xtensa.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/bfd/elf32-xtensa.c b/bfd/elf32-xtensa.c
index b1733345fc8..02225b9f38a 100644
--- a/bfd/elf32-xtensa.c
+++ b/bfd/elf32-xtensa.c
@@ -6912,6 +6912,9 @@ elf_xtensa_relax_section (bfd *abfd,
   static bool relocations_analyzed = false;
   xtensa_relax_info *relax_info;
 
+  if (!xtensa_default_isa)
+    xtensa_default_isa = xtensa_isa_init (0, 0);
+
   if (!relocations_analyzed)
     {
       /* Do some overall initialization for relaxation.  */
